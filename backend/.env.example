# Copy to .env and fill in real values. Never commit .env.
PORT=4000
NODE_ENV=development

# SQLite file path (relative paths resolve from the backend/ directory)
DATABASE_URL=./data/arogya.db

# Auth — generate long random strings for production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# CORS — comma-separated allowed origins
CORS_ORIGIN=http://localhost:5173

# Base URL used to generate teleconsult meeting links
MEET_BASE_URL=https://meet.arogya.mh.gov.in

# OTP demo code returned in API responses when NODE_ENV != production
OTP_DEMO_CODE=123456
