# Copy to backend/.env and fill in real values. Never commit .env.

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database ---
# SQLite file path (relative paths resolve from backend/). For Postgres after the
# swap described in README §6, use a postgres:// URL instead.
DATABASE_URL=./data/arogya.db

# --- Auth (generate long random strings for production, e.g. `openssl rand -hex 64`) ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS: comma-separated allowed frontend origins ---
CORS_ORIGIN=http://localhost:5173

# --- Teleconsult meeting links ---
MEET_BASE_URL=https://meet.arogya.mh.gov.in

# --- OTP (dev only: returned in API responses when NODE_ENV != production) ---
OTP_DEMO_CODE=123456

# --- ABHA / ABDM ---
# Provider: "mock" (built-in deterministic demo registry) or "abdm" (real ABDM APIs).
# The "abdm" provider is a stub: it returns HTTP 501 until a real ABDM integration
# is implemented. Keep ABHA_PROVIDER=mock until then.
ABHA_PROVIDER=mock
# When ABHA_PROVIDER=abdm and the integration is implemented, these are required:
# ABDM_BASE_URL=https://dev.abdm.gov.in/gateway
# ABDM_CLIENT_ID=
# ABDM_CLIENT_SECRET=
# Exact integration checklist (see README "ABHA / ABDM integration"):
#   1. Register a Health Facility / HIP on the ABDM sandbox and obtain client credentials.
#   2. Implement auth: POST {ABDM_BASE_URL}/v0.5/sessions with clientId/clientSecret -> access token.
#   3. Implement ABHA search/verify: GET /v1/search/searchByHealthId, POST /v1/registration/aadhaar/...
#   4. Implement consent manager callbacks for the HIE-CM flow (consent request/on-fetch).
#   5. Map the real responses to the linkConsent() return shape in backend/src/services/abhaService.js.
#   6. Set ABHA_PROVIDER=abdm and restart. Never send real patient PII through the mock provider.

# --- FINAL CONFIGURATION REQUIRED (not yet wired, see README) ---
# SMS_GATEWAY_API_KEY=
# SMS_SENDER_ID=
# STORAGE_URL=
# STORAGE_KEY=
